@{
    ViewData["Title"] = "Greetings";

    string myMessage = "Hello C# Marathon!";
    string greeting = "Welcome to our project!";

    DateTime now = DateTime.Now;
    string dayOfWeek = now.DayOfWeek.ToString();

    string wish;
    if (now.Hour < 12)
    {
        wish = "Good Morning!";
    }
    else
    {
        wish = "Good Evening!";
    }
}

<h1>Greetings</h1>

<p>The value of myMessage is: @myMessage</p>
<p>The greeting is: @greeting</p>
<p>Here in Ukraine: @dayOfWeek</p>
<p>We wish you: @wish</p>
<p>Today is @dayOfWeek</p>
     
<table class="table" style="width: 200px;">
    <thead>
        <tr>
            <th>Name</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>Day</td><td>@now.Day</td></tr>
        <tr><td>Hour</td><td>@now.Hour</td></tr>
        <tr><td>Minute</td><td>@now.Minute</td></tr>
        <tr><td>Second</td><td>@now.Second</td></tr>
    </tbody>
</table>
